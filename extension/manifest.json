{
  "manifest_version": 3,
  "name": "QtAria",
  "version": "1.0",
  "description": "Send downloads to QtAria",
  "permissions": [
    "contextMenus",
    "nativeMessaging",
    "notifications"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png"
  },
  "key": ""
}